# Site
NEXT_PUBLIC_SITE_URL=https://reservecoatings.com

# SMS uses lib/brand.ts (same number as site phone) — no env var needed

# Email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=info@reservecoatings.com
RESEND_TO_EMAIL=info@reservecoatings.com

# CRM (GoHighLevel-compatible webhook)
CRM_WEBHOOK_URL=

# Google Sheets appointment log (Apps Script web app URL)
GOOGLE_SHEETS_WEBHOOK_URL=

# UploadThing (required for instant-quote photo uploads)
# Dashboard → API Keys → copy the token (v7 uses a single base64 UPLOADTHING_TOKEN)
UPLOADTHING_TOKEN=

# Financing
NEXT_PUBLIC_HEARTH_APPLY_URL=

# Maps (optional)
GOOGLE_MAPS_API_KEY=

# Post-launch stubs
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
DOCUSEAL_API_KEY=
HELLOSIGN_API_KEY=

# Optional SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
